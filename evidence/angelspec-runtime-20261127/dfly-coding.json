  "query": "SELECT p.id AS project_id,\n       COALESCE(SUM(CASE WHEN a.status = 'passed' THEN 1 ELSE 0 END), 0) AS passed_tasks\nFROM projects p\nLEFT JOIN (\n    SELECT project_id,\n           task_id,\n           status,\n           ROW_NUMBER() OVER (PARTITION BY project_id, task_id ORDER BY attempted_at DESC, id DESC) AS rn\n    FROM attempts\n) a\n  ON a.project_id = p.id\n AND a.rn = 1\nGROUP BY p.id\nORDER BY p.id;",
